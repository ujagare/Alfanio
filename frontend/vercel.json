{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://alfanio-ltd.onrender.com/api/:path*"
    },
    {
      "source": "/contact/:path*",
      "destination": "https://alfanio-ltd.onrender.com/contact/:path*"
    },
    {
      "source": "/brochure/:path*",
      "destination": "https://alfanio-ltd.onrender.com/brochure/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
