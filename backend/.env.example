# Alfanio LTD - Environment Variables Example
# Copy this file to .env and fill in the values for your environment

# Server Configuration
NODE_ENV=production
# Render provides PORT automatically. Set only for local testing.
PORT=5005

# MongoDB Configuration
# Recommended for Render: set this as a secret environment variable.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/Alfanio?retryWrites=true&w=majority

# Optional alternative if MONGODB_URI is not set.
# MONGO_USERNAME=your_atlas_username
# MONGO_PASSWORD=your_atlas_password
# MONGO_CLUSTER=your_atlas_cluster.mongodb.net
# MONGO_DB_NAME=Alfanio

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=Alfanio India
EMAIL_TO=alfanioindia@gmail.com

# Security
JWT_SECRET=replace_with_a_long_random_string
COOKIE_SECRET=replace_with_a_long_random_string

# Application URLs / CORS
CLIENT_URL=https://www.alfanio.com
FRONTEND_URL=https://www.alfanio.com

# Render
RENDER=true
