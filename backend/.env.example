# Alfanio LTD - Environment Variables Example
# Copy this file to .env and fill in the values for your environment

# Server Configuration
NODE_ENV=production
# Render provides PORT automatically. Set only for local testing.
PORT=5005

# Lead Email Delivery
EMAIL_FROM_NAME=Alfanio India
EMAIL_TO=alfanioindia@gmail.com
RESEND_API_KEY=your_resend_api_key
# Use onboarding@resend.dev only for Resend test mode. Use a verified sender/domain in production.
RESEND_FROM="Alfanio India <onboarding@resend.dev>"

# Supabase Lead Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_LEADS_TABLE=lead_submissions

# Security
JWT_SECRET=replace_with_a_long_random_string
COOKIE_SECRET=replace_with_a_long_random_string

# Application URLs / CORS
CLIENT_URL=https://www.alfanio.com
FRONTEND_URL=https://www.alfanio.com

# Render
RENDER=true
