# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration
# IMPORTANT: Set real credentials via the hosting provider's secret store
# (Render / Docker secrets / environment). Do NOT commit real values here.
MONGODB_URI=

# MongoDB Atlas Configuration
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_CLUSTER=
MONGO_DB_NAME=Alfanio

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=alfanioindia@gmail.com
# App Password from 2-step verification - set via secret store
EMAIL_PASS=
EMAIL_FROM_NAME=Alfanio India
EMAIL_TO=alfanioindia@gmail.com

# Application URLs - canonical public domain is www.alfanio.com
# Once api.alfanio.com DNS is configured, point VITE_API_URL there.
VITE_API_URL=https://www.alfanio.com
CLIENT_URL=https://www.alfanio.com
FRONTEND_URL=https://www.alfanio.com
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Security - generate strong random values and inject via secret store
JWT_SECRET=
COOKIE_SECRET=

# Render-specific settings
RENDER=true
